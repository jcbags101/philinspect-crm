# PhilInspectCRM Neon staging environment. Keep values in ignored local files
# or environment-scoped Vercel variables; never commit credentials.
POSTGRES_URL=
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Required only by `npm run test:integration`. This must identify an isolated
# Neon test branch and must never point to the staging runtime database.
TEST_DATABASE_URL=
TEST_DATABASE_TARGET=philinspect-crm-test
TEST_DATABASE_BRANCH_ID=
